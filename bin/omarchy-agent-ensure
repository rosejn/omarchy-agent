#!/usr/bin/env bash
set -euo pipefail

plugin_dir="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
unit_dir="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
unit="$unit_dir/omarchy-agent.service"
mkdir -p "$unit_dir"

if [[ ! -f $unit ]] || ! cmp -s "$plugin_dir/systemd/omarchy-agent.service" "$unit"; then
  sed "s|@PLUGIN_DIR@|$plugin_dir|g" "$plugin_dir/systemd/omarchy-agent.service" > "$unit"
  systemctl --user daemon-reload
fi
systemctl --user start omarchy-agent.service
